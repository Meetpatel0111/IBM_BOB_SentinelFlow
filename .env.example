# SentinelFlow — Optional integration environment variables
# Copy this file to .env and fill in real values to enable optional features.
# The project runs fully in simulation mode without any of these set.

# Shuffle SOAR webhook URL (leave blank to skip automated dispatch)
SHUFFLE_WEBHOOK_URL=

# AbuseIPDB API key for IP reputation enrichment (leave blank to skip)
ABUSEIPDB_KEY=
